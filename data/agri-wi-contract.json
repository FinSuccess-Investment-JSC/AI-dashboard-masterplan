 "about": "Các lời gọi WiMCP cho dashboard Nông nghiệp & thực phẩm. Routine Claude gọi lại đúng các lời gọi này (hook wi_capture.py lưu kết quả), rồi chạy scripts/build_agri_wi.py. Không chép tay số.",
 "calls": [
  {
   "block": "macro_agri",
   "tool": "wi_data_macro",
   "input": {
    "action": "get_values",
    "indicator_id": "83505,83502,83520,92095,92092,92098,92781,92756,92776,92795,74450,75702,75706,82086,82116,82084,82118,202900,202901",
    "from_time": "2019-01-01",
    "limit": 120
   },
   "cadence": "daily",
   "note": "Kết quả vượt trần hiển thị: chép file tool-results vào capture bằng build_realestate_wi.py --restore."
  },
  {
   "block": "commodity_agri",
   "tool": "wi_data_commodity",
   "input": {
    "action": "get_values",
    "indicator_id": "74124,74351,203105,203092,203096,203110",
    "from_time": "2023-10-01",
    "to_time": "2026-10-09",
    "limit": 1000
   },
   "cadence": "weekly",
   "match_keys": [
    "action",
    "indicator_id",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "Wi nén chuỗi ngày về cuối tháng. to_time = hôm nay khi gọi lại."
  },
  {
   "block": "sector_ratio_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_ratio_daily",
    "filters": "{\"sector_id\":\"282,239,240,235,120,241\"}",
    "columns": "sector_id,trading_date,pe,pb,market_cap",
    "by_time": "trading_date",
    "from_time": "2026-01-01",
    "to_time": "2026-10-09",
    "limit": 1000
   },
   "cadence": "daily",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "Trần 1000 dòng (6 ngành × ~167 phiên): cửa sổ thực tế từ đầu 02/2026."
  }
