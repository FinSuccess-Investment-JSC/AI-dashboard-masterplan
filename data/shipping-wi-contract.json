{
 "schema": 1,
 "about": "Các lời gọi WiMCP cho dashboard Vận tải biển. Routine Claude gọi lại đúng các lời gọi này, rồi chạy scripts/build_shipping_wi.py. Không chép tay số.",
 "calls": [
  {
   "block": "macro_shipping",
   "tool": "wi_data_macro",
   "input": {
    "action": "get_values",
    "indicator_id": "82585,82583,82497,75662,75661,83479,92728",
    "from_time": "2019-01-01",
    "limit": 120
   },
   "cadence": "daily"
  },
  {
   "block": "commodity_shipping",
   "tool": "wi_data_commodity",
   "input": {
    "action": "get_values",
    "indicator_id": "73982,73983,73984,203085,203125",
    "from_time": "2023-10-01",
    "to_time": "2026-10-10",
    "limit": 1000
   },
   "cadence": "weekly",
   "match_keys": [
    "action",
    "indicator_id",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "Wi nén chuỗi ngày về cuối tháng. to_time = hôm nay khi gọi lại. Wi không có SCFI, TCE, giá thuê tàu."
  },
  {
   "block": "sector_ratio_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_ratio_daily",
    "filters": "{\"sector_id\":\"185,309\"}",
    "columns": "sector_id,trading_date,pe,pb,market_cap",
    "by_time": "trading_date",
    "from_time": "2025-01-01",
    "to_time": "2026-10-10",
    "limit": 1000
   },
   "cadence": "daily",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time"
  },
  {
   "block": "commodity_fearnleys",
   "tool": "wi_data_commodity",
   "input": {
    "action": "get_values",
    "indicator_id": "1269507,1269495,1269483,1269399,1269447,1269459,1269411,1269387,1269375,1269363,1269351,1269315,1269303,1269339,1269327,1269291,1269255,1269519,1269531",
    "from_time": "2024-01-01",
    "to_time": "2026-11-05",
    "limit": 200
   },
   "cadence": "weekly",
   "match_keys": [
    "action",
    "indicator_id",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "Fearnleys (Wi bảng 362): TC 1 năm tanker VLCC/Suezmax/Aframax và hàng rời Capesize/Panamax/Supramax/Handysize; giá tàu cũ 5/10 tuổi VLCC/Suezmax/Aframax/MR; giá đóng mới VLCC, product tanker; VLCC sẵn sàng MEG 30 ngày; VLCC fixtures tuần trước. Chuỗi tuần, Wi nén về tháng khi gọi từ 2024 (limit 200). to_time = hôm nay khi gọi lại. Thêm 05/11/2026."
  }
 ],
