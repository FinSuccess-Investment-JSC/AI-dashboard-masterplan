{
 "schema": 1,
 "about": "Các lời gọi WiMCP cho dashboard Bán lẻ & tiêu dùng. Routine Claude gọi lại đúng các lời gọi này, rồi chạy scripts/build_retail_wi.py. Không chép tay số.",
 "calls": [
  {
   "block": "macro_retail_a",
   "tool": "wi_data_macro",
   "input": {
    "action": "get_values",
    "indicator_id": "74449,74450,265987,75931,75701,81412",
    "from_time": "2019-01-01",
    "limit": 100
   },
   "cadence": "monthly"
  },
  {
   "block": "macro_retail_b",
   "tool": "wi_data_macro",
   "input": {
    "action": "get_values",
    "indicator_id": "75702,75706,82086,82116,82084,202900,202901,82112,82109,92797",
    "from_time": "2021-01-01",
    "limit": 72
   },
   "cadence": "monthly",
   "note": "Tách hai lời gọi macro vì gộp 16 chỉ tiêu × 120 kỳ vượt trần kết quả."
  },
  {
   "block": "commodity_retail",
   "tool": "wi_data_commodity",
   "input": {
    "action": "get_values",
    "indicator_id": "74400,73972,203092,203105",
    "from_time": "2023-10-01",
    "to_time": "2026-10-11",
    "limit": 800
   },
   "cadence": "weekly",
   "match_keys": [
    "action",
    "indicator_id",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "Wi không có sữa bột WMP, lúa mạch, nhôm; đường, dầu cọ, khô đậu, ngô là đầu vào thực phẩm đồ uống có trên Wi."
  },
  {
   "block": "sector_ratio_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_ratio_daily",
    "filters": "{\"sector_id\":\"220,215,224,239,120\"}",
    "columns": "sector_id,trading_date,pe,pb,market_cap",
    "by_time": "trading_date",
    "from_time": "2025-01-01",
    "to_time": "2026-10-11",
    "limit": 1000
   },
   "cadence": "daily",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "5 phân ngành × 1000 dòng ≈ 10 tháng. PNJ không rõ thuộc phân ngành nào trên Wi (113 trống, 206 lệch) nên không vẽ."
  }
 ],
