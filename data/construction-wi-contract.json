  {
   "block": "sector_ratio_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_ratio_daily",
    "filters": "{\"sector_id\":\"281,264,260,170,171\"}",
    "columns": "sector_id,trading_date,pe,pb,market_cap",
    "by_time": "trading_date",
    "from_time": "2025-01-01",
    "to_time": "2026-10-10",
    "limit": 1000
   },
   "cadence": "daily",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time",
   "note": "5 phân ngành × 1000 dòng ≈ 10 tháng gần nhất."
  }
 ],
