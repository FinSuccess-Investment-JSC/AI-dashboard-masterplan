{
 "schema": 1,
 "about": "Các lời gọi WiMCP cho dashboard Bảo hiểm. Routine Claude gọi lại đúng các lời gọi này, rồi chạy scripts/build_insurance_wi.py. Không chép tay số.",
 "calls": [
  {
   "block": "macro_insurance",
   "tool": "wi_data_macro",
   "input": {
    "action": "get_values",
    "indicator_id": "242557,82112,82109,265987",
    "from_time": "2019-01-01",
    "limit": 120
   },
   "cadence": "monthly"
  },
  {
   "block": "sector_fs_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_fs_ins",
    "filters": "{\"sector_id\":\"151,285,154\",\"period_type\":\"q\"}",
    "columns": "sector_id,period_year,period_quarter,is01_1,is03,is15,is23,is25",
    "limit": 200
   },
   "cadence": "quarterly",
   "note": "BCTC tổng hợp toàn ngành theo phân ngành GICS (chỉ doanh nghiệp niêm yết). is01_1 phí BH gốc, is03 DT phí thuần, is15 tổng chi bồi thường và trả tiền BH (số âm), is23 DT tài chính, is25 LN hoạt động tài chính."
  },
  {
   "block": "gbond_10y",
   "tool": "wi_data_gbond",
   "input": {
    "action": "get_data",
    "endpoint_name": "bonds_gov_yield_curve",
    "filters": "{\"indicator_id\":\"234526\"}",
    "columns": "date,value",
    "by_time": "date",
    "from_time": "2024-01-01",
    "to_time": "2026-10-11",
    "limit": 800
   },
   "cadence": "weekly",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time"
  },
  {
   "block": "sector_ratio_recent",
   "tool": "wi_data_sector",
   "input": {
    "action": "get_data",
    "endpoint_name": "sector_ratio_daily",
    "filters": "{\"sector_id\":\"151,285,154\"}",
    "columns": "sector_id,trading_date,pe,pb,market_cap",
    "by_time": "trading_date",
    "from_time": "2025-01-01",
    "to_time": "2026-10-11",
    "limit": 1000
   },
   "cadence": "daily",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters",
    "from_time"
   ],
   "pick": "max_to_time"
  },
  {
   "block": "ratio_ins",
   "tool": "wi_data_companies",
   "input": {
    "action": "get_data",
    "endpoint_name": "ratio_ins",
    "filters": "{\"symbol\":\"BVH,BMI,PVI,MIG,PTI,BIC,VNR\",\"year\":\"2022,2023,2024,2025,2026\",\"quarter\":\"1,2,3,4\"}",
    "columns": "symbol,year,quarter,claim_ratio_nonlife_insurance,claim_ratio_motor_insurance,claim_ratio_health_insurance,claim_ratio_property_casualty_insurance,claim_ratio_fire_explosion_insurance,claim_ratio_life_insurance,pct_profit_insurance_operations,pct_profit_financial_activities,pct_investment_short_term_deposits,pct_investment_long_term_deposits,pct_investment_short_term_govt_bonds,pct_investment_long_term_govt_bonds,pct_investment_listed_shares,pct_revenue_motor_insurance,pct_revenue_health_insurance,pct_revenue_property_casualty_insurance,pct_revenue_fire_explosion_insurance,pct_revenue_marine_insurance,direct_premium_growth_yoy,net_premium_revenue_growth_yoy",
    "limit": 200
   },
   "cadence": "quarterly",
   "match_keys": [
    "action",
    "endpoint_name",
    "filters"
   ],
   "note": "Chỉ số bảo hiểm từng mã (ratio_ins): tỷ lệ bồi thường thuần (toàn PNT, xe, sức khỏe, tài sản, cháy nổ, nhân thọ), % LNTT từ nghiệp vụ BH / tài chính, cơ cấu danh mục đầu tư (tiền gửi, TPCP, cổ phiếu niêm yết), cơ cấu phí theo nghiệp vụ, tăng trưởng phí. Giá trị phân số 0–1, builder nhân 100. Công thức lấy từ meta._cong_thuc của capture, ghi vào bundle (formulas)."
  }
 ],
